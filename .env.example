# ControlPlane.ai Gateway & Services Configuration Template

# Gateway Settings
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Upstream API Keys (Optional, fallback values)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Third-party Integrations & Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/LINK
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key-here

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379

# Kafka Broker & Event Bus
KAFKA_BROKERS=localhost:19092

# Service URLs
TRI_GUARD_URL=http://localhost:8000
POLICY_SERVICE_URL=http://localhost:8001
AUDIT_SERVICE_URL=http://localhost:8002

# Policy Service database (PostgreSQL)
POLICY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/policy_db

# Audit Service database & search (Elasticsearch / WORM S3)
ELASTICSEARCH_URL=http://localhost:9200
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_AUDIT_BUCKET=controlplane-audit-vault-worm
